  "tokenColors": [
    {
      "name": "Default",
      "settings": {
        "foreground": "#BCBEC4"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7A7E85",
        "fontStyle": ""
      }
    },
    {
      "name": "Doc comments",
      "scope": [
        "comment.block.documentation",
        "comment.block.javadoc",
        "string.quoted.docstring",
        "comment.block.documentation punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5F826B",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc tags",
      "scope": [
        "storage.type.class.jsdoc",
        "storage.type.class.javadoc",
        "keyword.other.documentation",
        "comment.block.documentation storage.type"
      ],
      "settings": {
        "foreground": "#67A37C",
        "fontStyle": "italic bold"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.wordlike",
        "keyword.operator.instanceof",
        "keyword.operator.typeof",
        "keyword.operator.delete",
        "keyword.operator.in",
        "keyword.operator.of",
        "keyword.operator.sizeof",
        "constant.language",
        "variable.language.this",
        "variable.language.super",
        "support.type.primitive",
        "support.type.builtin",
        "keyword.type",
        "entity.name.type.primitive",
        "storage.type.primitive",
        "storage.type.built-in"
      ],
      "settings": {
        "foreground": "#CF8E6D"
      }
    },
    {
      "name": "Operators & punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#BCBEC4"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string",
        "markup.inline.raw.string"
      ],
      "settings": {
        "foreground": "#6AAB73"
      }
    },
    {
      "name": "String escapes & interpolation",
      "scope": [
        "constant.character.escape",
        "constant.character.format.placeholder",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "meta.template.expression punctuation",
        "meta.fstring.python constant.character.format",
        "storage.type.format.python"
      ],
      "settings": {
        "foreground": "#CF8E6D"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp",
        "keyword.operator.quantifier.regexp"
      ],
      "settings": {
        "foreground": "#42C3D4"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#2AACB8"
      }
    },
    {
      "name": "Function declarations",
      "scope": [
        "entity.name.function",
        "meta.definition.method entity.name.function",
        "meta.function entity.name.function",
        "entity.name.function.constructor"
      ],
      "settings": {
        "foreground": "#56A8F5"
      }
    },
    {
      "name": "Function calls",
      "scope": [
        "meta.function-call entity.name.function",
        "meta.method-call entity.name.function",
        "support.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#BCBEC4"
      }
    },
    {
      "name": "Types & classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "entity.name.namespace",
        "entity.name.module"
      ],
      "settings": {
        "foreground": "#BCBEC4"
      }
    },
    {
      "name": "Type parameters",
      "scope": [
        "entity.name.type.parameter",
        "meta.type.parameters entity.name.type",
        "storage.type.generic"
      ],
      "settings": {
        "foreground": "#16BAAC"
      }
    },
    {
      "name": "Fields & properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.property.object",
        "variable.other.member",
        "entity.name.variable.field",
        "support.variable.property",
        "meta.object-literal.key",
        "variable.other.field"
      ],
      "settings": {
        "foreground": "#C77DBB"
      }
    },
    {
      "name": "Constants & enum members",
      "scope": [
        "variable.other.constant",
        "variable.other.enummember",
        "entity.name.constant",
        "constant.other.caps",
        "support.constant"
      ],
      "settings": {
        "foreground": "#C77DBB",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#BCBEC4"
      }
    },
    {
      "name": "self / cls",
      "scope": [
        "variable.parameter.function.language.special.self",
        "variable.language.special.self",
        "variable.parameter.function.language.special.cls",
        "variable.language.special.cls"
      ],
      "settings": {
        "foreground": "#94558D"
      }
    },
    {
      "name": "Builtins",
      "scope": [
        "support.function.builtin",
        "support.type.python",
        "support.function.magic",
        "support.variable.magic"
      ],
      "settings": {
        "foreground": "#8888C6"
      }
    },
    {
      "name": "Annotations & decorators",
      "scope": [
        "meta.annotation",
        "storage.type.annotation",
        "punctuation.definition.annotation",
        "entity.name.function.decorator",
        "meta.decorator",
        "punctuation.decorator",
        "meta.function.decorator",
        "meta.attribute.rust",
        "meta.attribute"
      ],
      "settings": {
        "foreground": "#B3AE60"
      }
    },
    {
      "name": "Labels",
      "scope": [
        "entity.name.label",
        "punctuation.definition.label"
      ],
      "settings": {
        "foreground": "#32B8AF"
      }
    },
    {
      "name": "Tags (HTML/XML/JSX)",
      "scope": [
        "entity.name.tag",
        "support.class.component",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#D5B778"
      }
    },
    {
      "name": "Tag attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#BCBEC4"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.pseudo-class",
        "entity.name.tag.css",
        "entity.other.attribute-name.class",
        "entity.other.attribute-name.id"
      ],
      "settings": {
        "foreground": "#D5B778"
      }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#C77DBB"
      }
    },
    {
      "name": "CSS values",
      "scope": [
        "support.constant.property-value",
        "support.constant.font-name",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#6AAB73"
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json",
        "meta.mapping.key.json string",
        "support.type.property-name.toml"
      ],
      "settings": {
        "foreground": "#C77DBB"
      }
    },
    {
      "name": "YAML keys",
      "scope": [
        "entity.name.tag.yaml",
        "meta.mapping.key.yaml",
        "support.type.property-name.yaml"
      ],
      "settings": {
        "foreground": "#CF8E6D"
      }
    },
    {
      "name": "YAML anchors",
      "scope": [
        "entity.name.type.anchor.yaml",
        "variable.other.alias.yaml"
      ],
      "settings": {
        "foreground": "#C77DBB"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "markup.heading.setext"
      ],
      "settings": {
        "foreground": "#CF8E6D",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#BCBEC4"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "meta.link.inline.markdown"
      ],
      "settings": {
        "foreground": "#56A8F5"
      }
    },
    {
      "name": "TODO / FIXME",
      "scope": [
        "comment keyword.codetag",
        "keyword.codetag.notation",
        "comment.line.todo",
        "storage.type.class.todo"
      ],
      "settings": {
        "foreground": "#8BB33D",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown quotes & lists",
      "scope": [
        "markup.quote",
        "punctuation.definition.list.begin.markdown",
        "punctuation.definition.quote.begin.markdown"
      ],
      "settings": {
        "foreground": "#7A7E85"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#6AAB73"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#F75464"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#56A8F5"
      }
    },
    {
      "name": "Shell variables",
      "scope": [
        "variable.other.normal.shell",
        "variable.other.positional.shell",
        "variable.other.special.shell",
        "punctuation.definition.variable.shell"
      ],
      "settings": {
        "foreground": "#C77DBB"
      }
    },
    {
      "name": "Env file keys",
      "scope": [
        "variable.other.env",
        "variable.other.dotenv"
      ],
      "settings": {
        "foreground": "#C77DBB"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#F75464"
      }
    }
  ],
  "semanticTokenColors": {
    "function.declaration": "#56A8F5",
    "method.declaration": "#56A8F5",
    "function": "#BCBEC4",
    "method": "#BCBEC4",
    "class": "#BCBEC4",
    "interface": "#BCBEC4",
    "type": "#BCBEC4",
    "struct": "#BCBEC4",
    "namespace": "#BCBEC4",
    "typeParameter": "#16BAAC",
    "parameter": "#BCBEC4",
    "variable": "#BCBEC4",
    "property": "#C77DBB",
    "enumMember": {
      "foreground": "#C77DBB",
      "fontStyle": "italic"
    },
    "property.static": {
      "foreground": "#C77DBB",
      "fontStyle": "italic"
    },
    "method.static": {
      "foreground": "#BCBEC4",
      "fontStyle": "italic"
    },
    "variable.static": {
      "foreground": "#C77DBB",
      "fontStyle": "italic"
    },
    "decorator": "#B3AE60",
    "macro": "#B3AE60",
    "label": "#32B8AF",
    "selfParameter": "#94558D",
    "selfKeyword": "#94558D",
    "keyword": "#CF8E6D",
    "builtinConstant": "#CF8E6D",
    "number": "#2AACB8",
    "string": "#6AAB73",
    "regexp": "#42C3D4",
    "comment": "#7A7E85"
  }
}
