{
  "name": "jb-look",
  "displayName": "JB Look — IntelliJ-style Theme & Icons",
  "description": "Dark color theme, file icons and editor settings modeled on the JetBrains New UI.",
  "version": "0.7.0",
  "publisher": "local",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "icon theme",
    "intellij",
    "new ui",
    "dark"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "themes": [
      {
        "label": "JB Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/jb-dark-color-theme.json"
      }
    ],
    "iconThemes": [
      {
        "id": "jb-icons",
        "label": "JB Icons",
        "path": "./icons/jb-icon-theme.json"
      }
    ],
    "commands": [
      {
        "command": "jbLook.applyRecommendedSettings",
        "title": "Apply Recommended IntelliJ-style Settings",
        "category": "JB Look"
      },
      {
        "command": "jbLook.restoreSettings",
        "title": "Restore Settings From Before JB Look",
        "category": "JB Look"
      },
      {
        "command": "jbLook.showUsages",
        "title": "Show Usages",
        "category": "JB Look"
      },
      {
        "command": "jbLook.gotoDeclarationOrUsages",
        "title": "Go to Declaration or Usages",
        "category": "JB Look"
      }
    ],
    "colors": [
      {
        "id": "jbLook.dimmedForeground",
        "description": "Label color for greyed-out dependency/build folders (node_modules, dist, …).",
        "defaults": {
          "dark": "#6F737A",
          "light": "#8C8C8C",
          "highContrast": "#6F737A"
        }
      }
    ],
    "keybindings": [
      {
        "key": "cmd+alt+left",
        "command": "workbench.action.navigateBack"
      },
      {
        "key": "cmd+alt+right",
        "command": "workbench.action.navigateForward"
      },
      {
        "key": "cmd+[",
        "command": "workbench.action.navigateBack"
      },
      {
        "key": "cmd+]",
        "command": "workbench.action.navigateForward"
      },
      {
        "key": "cmd+alt+f7",
        "command": "jbLook.showUsages",
        "when": "editorTextFocus"
      },
      {
        "key": "cmd+b",
        "command": "jbLook.gotoDeclarationOrUsages",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build-themes.mjs && node scripts/build-icons.mjs",
    "validate": "node scripts/validate.mjs",
    "package": "vsce package --allow-missing-repository --skip-license --out dist/"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.1"
  }
}
